@@ -0,0 +1,104 @@
+"""Ratings and ride history (CRS-F-050..053)."""
+from __future__ import annotations
+
+from dataclasses import dataclass
+from datetime import datetime, timedelta
+from typing import Optional
+
+from .errors import ConflictError, NotFound, PermissionDenied, ValidationError
+from .models import Booking, BookingStatus
+
+RATING_WINDOW = timedelta(days=7)
+MAX_COMMENT = 300
+MIN_RATINGS_TO_SHOW = 3
+
+
+@dataclass(frozen=True)  # frozen: ratings cannot be edited after submission (CRS-F-053)
+class Rating:
+    id: int
+    booking_id: str
+    rater_id: str
+    ratee_id: str
+    stars: int
+    comment: str
+    created_at: datetime
+
+
+class RatingService:
+    def __init__(self):
+        self._ratings: list[Rating] = []
+        self.flagged: list[tuple[int, str]] = []  # (rating_id, flagged_by)
+
+    # CRS-F-051
+    def submit(self, booking: Booking, rater_id: str, stars: int, comment: str, now: datetime) -> Rating:
+        if rater_id not in (booking.rider_id, booking.driver_id):
+            raise PermissionDenied("Only ride participants can rate")
+        if booking.status is not BookingStatus.COMPLETED or booking.ended_at is None:
+            raise ConflictError("The ride is not completed")
+        if now - booking.ended_at > RATING_WINDOW:
+            raise ConflictError("The 7-day rating window has closed")
+        if isinstance(stars, bool) or not isinstance(stars, int) or not 1 <= stars <= 5:
+            raise ValidationError("Stars must be a whole number from 1 to 5")
+        comment = (comment or "").strip()
+        if len(comment) > MAX_COMMENT:
+            raise ValidationError("Comment is too long (max 300 characters)")
+        if any(r.booking_id == booking.id and r.rater_id == rater_id for r in self._ratings):
+            raise ConflictError("You have already rated this ride")
+        ratee = booking.driver_id if rater_id == booking.rider_id else booking.rider_id
+        rating = Rating(len(self._ratings) + 1, booking.id, rater_id, ratee, stars, comment, now)
+        self._ratings.append(rating)
+        return rating
+
+    # CRS-F-052
+    def average(self, user_id: str) -> tuple:
+        mine = [r.stars for r in self._ratings if r.ratee_id == user_id]
+        if not mine:
+            return None, 0
+        return round(sum(mine) / len(mine), 2), len(mine)
+
+    def display_label(self, user_id: str) -> str:
+        avg, count = self.average(user_id)
+        if count < MIN_RATINGS_TO_SHOW:
+            return "New"
+        return f"{avg:.1f} ({count})"
+
+    def ratings_map(self) -> dict:
+        """Average rating per user for the matching engine (only users with enough ratings)."""
+        users = {r.ratee_id for r in self._ratings}
+        out = {}
+        for u in users:
+            avg, count = self.average(u)
+            if count >= MIN_RATINGS_TO_SHOW:
+                out[u] = avg
+        return out
+
+    # CRS-F-053
+    def flag_comment(self, rating_id: int, flagged_by: str) -> None:
+        if not any(r.id == rating_id for r in self._ratings):
+            raise NotFound("Rating not found")
+        self.flagged.append((rating_id, flagged_by))
+
+
+def ride_history(bookings, user_id: str, role: Optional[str] = None, status: Optional[BookingStatus] = None,
+                 start: Optional[datetime] = None, end: Optional[datetime] = None) -> list:
+    """CRS-F-050: only the user's own rides, newest first, filterable by role/status/date."""
+    out = []
+    for b in bookings:
+        if user_id not in (b.rider_id, b.driver_id):
+            continue
+        if b.status not in (BookingStatus.COMPLETED, BookingStatus.CANCELLED, BookingStatus.REJECTED,
+                            BookingStatus.EXPIRED):
+            continue
+        if role == "rider" and b.rider_id != user_id:
+            continue
+        if role == "driver" and b.driver_id != user_id:
+            continue
+        if status is not None and b.status is not status:
+            continue
+        when = b.departure
+        if start and when < start:
+            continue
+        if end and when > end:
+            continue
+        out.append(b)
+    return sorted(out, key=lambda b: b.departure, reverse=True)
diff --git a/tests/test_ratings.py b/tests/test_ratings.py
new file mode 100644
index 0000000..153512a
--- /dev/null
+++ b/tests/test_ratings.py
@@ -0,0 +1,85 @@
+from datetime import datetime, timedelta
+
+import pytest
+
+from campusride.errors import ConflictError, NotFound, PermissionDenied, ValidationError
+from campusride.models import Booking, BookingStatus
+from campusride.ratings import RatingService, ride_history
+
+END = datetime(2026, 10, 13, 10, 0)
+
+
+def done(bid="b1", rider="r1", driver="d1", status=BookingStatus.COMPLETED, dep=None):
+    dep = dep or END - timedelta(hours=1)
+    return Booking(id=bid, offer_id="o1", driver_id=driver, rider_id=rider, seats=1, status=status,
+                   created_at=dep - timedelta(days=1), departure=dep, ended_at=END)
+
+
+def test_valid_rating_after_completion():  # TC-Rate-01
+    svc = RatingService()
+    r = svc.submit(done(), "r1", 5, "Great driver", END + timedelta(hours=1))
+    assert (r.ratee_id, r.stars) == ("d1", 5)
+    assert svc.submit(done(), "d1", 4, "", END).ratee_id == "r1"  # mutual rating
+
+
+@pytest.mark.parametrize("stars", [0, 6, 4.5, "5", True])
+def test_stars_must_be_whole_1_to_5(stars):  # TC-Rate-02
+    with pytest.raises(ValidationError):
+        RatingService().submit(done(), "r1", stars, "", END)
+
+
+def test_duplicate_late_and_non_participant_rejected():  # TC-Rate-02
+    svc = RatingService()
+    svc.submit(done(), "r1", 5, "", END)
+    with pytest.raises(ConflictError):
+        svc.submit(done(), "r1", 4, "", END)
+    with pytest.raises(ConflictError):
+        RatingService().submit(done(), "r1", 4, "", END + timedelta(days=7, seconds=1))
+    assert RatingService().submit(done(), "r1", 4, "", END + timedelta(days=7))  # boundary OK
+    with pytest.raises(PermissionDenied):
+        RatingService().submit(done(), "stranger", 4, "", END)
+    with pytest.raises(ConflictError):
+        RatingService().submit(done(status=BookingStatus.CONFIRMED), "r1", 4, "", END)
+    with pytest.raises(ValidationError):
+        RatingService().submit(done(), "r1", 4, "x" * 301, END)
+
+
+def test_average_and_new_label():  # TC-Rate-03
+    svc = RatingService()
+    assert svc.average("d1") == (None, 0) and svc.display_label("d1") == "New"
+    for i, stars in enumerate([5, 4, 3], start=1):
+        svc.submit(done(bid=f"b{i}", rider=f"r{i}"), f"r{i}", stars, "", END)
+        if i < 3:
+            assert svc.display_label("d1") == "New"
+    assert svc.average("d1") == (4.0, 3)
+    assert svc.display_label("d1") == "4.0 (3)"
+    assert svc.ratings_map() == {"d1": 4.0}
+
+
+def test_ratings_immutable_and_flaggable():  # TC-Rate-04
+    svc = RatingService()
+    r = svc.submit(done(), "r1", 1, "rude", END)
+    with pytest.raises(Exception):
+        r.stars = 5  # type: ignore[misc]
+    svc.flag_comment(r.id, "d1")
+    assert svc.flagged == [(r.id, "d1")]
+    with pytest.raises(NotFound):
+        svc.flag_comment(99, "d1")
+
+
+def test_history_shows_only_own_rides_with_filters():  # TC-Hist-01
+    base = END
+    bs = [
+        done("b1", "r1", "d1", dep=base - timedelta(days=3)),
+        done("b2", "r2", "r1", dep=base - timedelta(days=2)),                 # r1 drove this one
+        done("b3", "r3", "d9", dep=base - timedelta(days=1)),                 # someone else's
+        done("b4", "r1", "d1", BookingStatus.CANCELLED, base - timedelta(days=1)),
+        done("b5", "r1", "d1", BookingStatus.CONFIRMED, base + timedelta(days=1)),  # upcoming, not history
+    ]
+    ids = lambda xs: [b.id for b in xs]
+    assert ids(ride_history(bs, "r1")) == ["b4", "b2", "b1"]            # newest first, no strangers
+    assert ids(ride_history(bs, "r1", role="driver")) == ["b2"]
+    assert ids(ride_history(bs, "r1", role="rider")) == ["b4", "b1"]
+    assert ids(ride_history(bs, "r1", status=BookingStatus.CANCELLED)) == ["b4"]
+    assert ids(ride_history(bs, "r1", start=base - timedelta(days=2, hours=1))) == ["b4", "b2"]
+    assert ride_history(bs, "nobody") == []

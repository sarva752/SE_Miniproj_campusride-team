@@ -0,0 +1,137 @@
+"""Administration: driver verification, sanctions, configuration, analytics, audit log.
+
+Covers CRS-F-006, CRS-F-070..074 and CRS-SR-003/009.
+"""
+from __future__ import annotations
+
+from dataclasses import dataclass
+from datetime import datetime
+from typing import Optional
+
+from .errors import ConflictError, NotFound, PermissionDenied, ValidationError
+from .models import OfferStatus, RequestStatus, Role, User, UserStatus
+
+DEFAULT_CONFIG = {
+    "match_radius_m": 1000,
+    "request_expiry_min": 30,
+    "rating_window_days": 7,
+    "allowed_domains": ["example.edu"],
+}
+CONFIG_RULES = {
+    "match_radius_m": lambda v: isinstance(v, int) and 100 <= v <= 10_000,
+    "request_expiry_min": lambda v: isinstance(v, int) and 5 <= v <= 1440,
+    "rating_window_days": lambda v: isinstance(v, int) and 1 <= v <= 30,
+    "allowed_domains": lambda v: isinstance(v, list) and len(v) > 0 and all(isinstance(d, str) and "." in d for d in v),
+}
+
+
+@dataclass
+class DriverApplication:
+    user_id: str
+    model: str
+    reg_no: str
+    capacity: int
+    licence_no: str
+    status: str = "PENDING"  # PENDING / APPROVED / REJECTED
+    reason: str = ""
+
+
+class AdminService:
+    def __init__(self):
+        self.applications: dict[str, DriverApplication] = {}
+        self.config = dict(DEFAULT_CONFIG)
+        self._audit: list[tuple[datetime, str, str, str]] = []  # append-only (time, actor, action, detail)
+        self.users: dict[str, User] = {}
+
+    # ---- audit log (CRS-F-074, CRS-SR-009): read access returns a copy, no edit/delete API
+    def log(self, actor: str, action: str, detail: str, now: datetime) -> None:
+        self._audit.append((now, actor, action, detail))
+
+    def audit_log(self) -> tuple:
+        return tuple(self._audit)
+
+    @staticmethod
+    def _require_admin(user: User) -> None:
+        if user.role is not Role.ADMIN:
+            raise PermissionDenied("Administrator role required")  # CRS-SR-003
+
+    # ---- driver verification (CRS-F-006, CRS-F-070)
+    def apply_as_driver(self, user: User, model: str, reg_no: str, capacity: int, licence_no: str) -> DriverApplication:
+        if not (model or "").strip() or not (reg_no or "").strip() or not (licence_no or "").strip():
+            raise ValidationError("Vehicle model, registration number and licence are required")
+        if not 2 <= capacity <= 8:
+            raise ValidationError("Seat capacity must be between 2 and 8")
+        existing = self.applications.get(user.id)
+        if existing and existing.status == "PENDING":
+            raise ConflictError("Application already pending")
+        app = DriverApplication(user.id, model.strip(), reg_no.strip(), capacity, licence_no.strip())
+        self.applications[user.id] = app
+        return app
+
+    def pending_applications(self, admin: User) -> list:
+        self._require_admin(admin)
+        return [a for a in self.applications.values() if a.status == "PENDING"]
+
+    def review_application(self, admin: User, user: User, approve: bool, reason: str, now: datetime) -> DriverApplication:
+        self._require_admin(admin)
+        app = self.applications.get(user.id)
+        if not app:
+            raise NotFound("No application for this user")
+        if not approve and not (reason or "").strip():
+            raise ValidationError("A reason is required when rejecting")
+        app.status, app.reason = ("APPROVED", "") if approve else ("REJECTED", reason.strip())
+        if approve:
+            user.role = Role.DRIVER
+        self.log(admin.id, "DRIVER_APPROVED" if approve else "DRIVER_REJECTED", user.id, now)
+        return app
+
+    def can_post_offers(self, user: User) -> bool:
+        app = self.applications.get(user.id)
+        return user.role is Role.DRIVER and bool(app) and app.status == "APPROVED"
+
+    # ---- moderation (CRS-F-071)
+    def suspend_user(self, admin: User, user: User, reason: str, offers: list, requests: list, now: datetime) -> User:
+        self._require_admin(admin)
+        if not (reason or "").strip():
+            raise ValidationError("A reason is required")
+        user.status = UserStatus.SUSPENDED
+        for o in offers:
+            if o.driver_id == user.id and o.status in (OfferStatus.OPEN, OfferStatus.FULL):
+                o.status = OfferStatus.CANCELLED
+        for r in requests:
+            if r.rider_id == user.id and r.status is RequestStatus.OPEN:
+                r.status = RequestStatus.CANCELLED
+        self.log(admin.id, "USER_SUSPENDED", f"{user.id}: {reason.strip()}", now)
+        return user
+
+    # ---- configuration (CRS-F-072)
+    def update_config(self, admin: User, key: str, value, now: datetime) -> dict:
+        self._require_admin(admin)
+        if key not in CONFIG_RULES:
+            raise ValidationError(f"Unknown setting: {key}")
+        if not CONFIG_RULES[key](value):
+            raise ValidationError(f"Invalid value for {key}")
+        old = self.config[key]
+        self.config[key] = value
+        self.log(admin.id, "CONFIG_CHANGED", f"{key}: {old} -> {value}", now)
+        return dict(self.config)
+
+    # ---- analytics (CRS-F-073)
+    @staticmethod
+    def analytics(users, offers, bookings) -> dict:
+        from .models import BookingStatus
+        total = len(bookings)
+        matched = sum(b.status in (BookingStatus.CONFIRMED, BookingStatus.STARTED, BookingStatus.COMPLETED) for b in bookings)
+        cancelled = sum(b.status is BookingStatus.CANCELLED for b in bookings)
+        return {
+            "active_users": sum(u.status is UserStatus.ACTIVE for u in users),
+            "offers": len(offers),
+            "bookings": total,
+            "rides_matched": matched,
+            "match_rate": round(matched / total, 4) if total else 0.0,
+            "cancellations": cancelled,
+        }
+
+    @staticmethod
+    def analytics_csv(stats: dict) -> str:
+        return "metric,value\n" + "\n".join(f"{k},{v}" for k, v in stats.items()) + "\n"
diff --git a/tests/test_admin.py b/tests/test_admin.py
new file mode 100644
index 0000000..f67a6a1
--- /dev/null
+++ b/tests/test_admin.py
@@ -0,0 +1,118 @@
+from datetime import datetime, timedelta
+
+import pytest
+
+from campusride.admin import AdminService
+from campusride.errors import ConflictError, NotFound, PermissionDenied, ValidationError
+from campusride.models import (Booking, BookingStatus, GeoPoint, OfferStatus, RequestStatus, RideOffer,
+                               RideRequest, Role, User, UserStatus)
+
+NOW = datetime(2026, 10, 13, 8, 0)
+P = GeoPoint(13.0, 80.2)
+
+
+def users():
+    admin = User("a1", "admin@example.edu", "Admin", Role.ADMIN, UserStatus.ACTIVE)
+    rider = User("u1", "asha@example.edu", "Asha", Role.RIDER, UserStatus.ACTIVE)
+    return admin, rider
+
+
+def apply(svc, rider):
+    return svc.apply_as_driver(rider, "Swift", "TN01AB1234", 5, "DL-998877")
+
+
+def test_driver_cannot_post_before_approval_then_can():  # TC-Prof-02 / TC-Admin-01
+    svc = AdminService()
+    admin, rider = users()
+    apply(svc, rider)
+    assert not svc.can_post_offers(rider)
+    assert len(svc.pending_applications(admin)) == 1
+    svc.review_application(admin, rider, True, "", NOW)
+    assert svc.can_post_offers(rider) and rider.role is Role.DRIVER
+    assert svc.pending_applications(admin) == []
+
+
+def test_rejection_needs_reason_and_keeps_rider_role():  # TC-Admin-01
+    svc = AdminService()
+    admin, rider = users()
+    apply(svc, rider)
+    with pytest.raises(ValidationError):
+        svc.review_application(admin, rider, False, " ", NOW)
+    svc.review_application(admin, rider, False, "Licence unreadable", NOW)
+    assert not svc.can_post_offers(rider) and rider.role is Role.RIDER
+    apply(svc, rider)  # may re-apply after rejection
+
+
+def test_application_validation_and_duplicates():  # TC-Prof-02
+    svc = AdminService()
+    _, rider = users()
+    with pytest.raises(ValidationError):
+        svc.apply_as_driver(rider, "", "TN01", 5, "DL")
+    with pytest.raises(ValidationError):
+        svc.apply_as_driver(rider, "Swift", "TN01", 1, "DL")
+    apply(svc, rider)
+    with pytest.raises(ConflictError):
+        apply(svc, rider)
+
+
+def test_admin_only_actions_are_enforced():  # CRS-SR-003
+    svc = AdminService()
+    _, rider = users()
+    with pytest.raises(PermissionDenied):
+        svc.pending_applications(rider)
+    with pytest.raises(PermissionDenied):
+        svc.update_config(rider, "match_radius_m", 500, NOW)
+    with pytest.raises(PermissionDenied):
+        svc.suspend_user(rider, rider, "x", [], [], NOW)
+    with pytest.raises(NotFound):
+        svc.review_application(users()[0], rider, True, "", NOW)
+
+
+def test_suspension_removes_open_items_and_is_audited():  # TC-Admin-03
+    svc = AdminService()
+    admin, rider = users()
+    offer = RideOffer("o1", "u1", P, P, [P, P], NOW + timedelta(hours=2), 2, 2)
+    done = RideOffer("o2", "u1", P, P, [P, P], NOW, 2, 2, status=OfferStatus.COMPLETED)
+    req = RideRequest("r1", "u1", P, P, NOW, NOW + timedelta(hours=1))
+    svc.suspend_user(admin, rider, "harassment", [offer, done], [req], NOW)
+    assert rider.status is UserStatus.SUSPENDED
+    assert offer.status is OfferStatus.CANCELLED and done.status is OfferStatus.COMPLETED
+    assert req.status is RequestStatus.CANCELLED
+    assert svc.audit_log()[-1][2] == "USER_SUSPENDED"
+    with pytest.raises(ValidationError):
+        svc.suspend_user(admin, rider, "", [], [], NOW)
+
+
+def test_configuration_changes_validated_and_audited():  # TC-Admin-04
+    svc = AdminService()
+    admin, _ = users()
+    assert svc.update_config(admin, "match_radius_m", 1500, NOW)["match_radius_m"] == 1500
+    for key, bad in [("match_radius_m", 50), ("match_radius_m", "big"), ("request_expiry_min", 0),
+                     ("allowed_domains", []), ("nope", 1)]:
+        with pytest.raises(ValidationError):
+            svc.update_config(admin, key, bad, NOW)
+    assert svc.config["match_radius_m"] == 1500
+    assert "1000 -> 1500" in svc.audit_log()[-1][3]
+
+
+def test_analytics_and_csv_export():  # TC-Admin-05
+    admin, rider = users()
+    bookings = [Booking("b1", "o1", "d1", "r1", 1, BookingStatus.CONFIRMED),
+                Booking("b2", "o1", "d1", "r2", 1, BookingStatus.CANCELLED),
+                Booking("b3", "o1", "d1", "r3", 1, BookingStatus.COMPLETED),
+                Booking("b4", "o1", "d1", "r4", 1, BookingStatus.REJECTED)]
+    stats = AdminService.analytics([admin, rider], [object()], bookings)
+    assert stats["active_users"] == 2 and stats["rides_matched"] == 2 and stats["cancellations"] == 1
+    assert stats["match_rate"] == 0.5
+    csv = AdminService.analytics_csv(stats)
+    assert csv.splitlines()[0] == "metric,value" and "match_rate,0.5" in csv
+    assert AdminService.analytics([], [], [])["match_rate"] == 0.0
+
+
+def test_audit_log_is_append_only_view():  # TC-Admin-06 / TC-Sec-10
+    svc = AdminService()
+    svc.log("a1", "TEST", "x", NOW)
+    log = svc.audit_log()
+    assert isinstance(log, tuple)
+    assert not hasattr(svc, "delete_audit") and not hasattr(svc, "edit_audit")
+    assert svc.audit_log() == log

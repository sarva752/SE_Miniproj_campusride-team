--- /dev/null
+++ b/src/campusride/booking.py
@@ -0,0 +1,154 @@
+"""Booking lifecycle: join request, accept/reject, cancel, expiry, start/complete.
+
+Covers CRS-F-024, CRS-F-030..035. A lock makes seat allocation atomic (CRS-F-024); in the
+production design this is the conditional SQL UPDATE described in SAD section 4.1.2.
+"""
+from __future__ import annotations
+
+import threading
+from datetime import datetime, timedelta
+from typing import Optional
+
+from .errors import ConflictError, NotFound, PermissionDenied, ValidationError
+from .models import Booking, BookingStatus, OfferStatus, RideOffer
+
+REQUEST_TIMEOUT = timedelta(minutes=30)
+LATE_CANCEL_WINDOW = timedelta(hours=1)
+LATE_CANCEL_LIMIT = 3
+LATE_CANCEL_PERIOD = timedelta(days=30)
+
+ACTIVE = (BookingStatus.PENDING, BookingStatus.CONFIRMED)
+
+
+class BookingService:
+    def __init__(self):
+        self.offers: dict[str, RideOffer] = {}
+        self.bookings: dict[str, Booking] = {}
+        self.late_cancellations: dict[str, list[datetime]] = {}
+        self._lock = threading.Lock()
+        self._seq = 0
+
+    def add_offer(self, offer: RideOffer) -> None:
+        self.offers[offer.id] = offer
+
+    def _offer(self, offer_id: str) -> RideOffer:
+        if offer_id not in self.offers:
+            raise NotFound("Offer not found")
+        return self.offers[offer_id]
+
+    def _booking(self, booking_id: str) -> Booking:
+        if booking_id not in self.bookings:
+            raise NotFound("Booking not found")
+        return self.bookings[booking_id]
+
+    # CRS-F-030
+    def send_join_request(self, offer_id: str, rider_id: str, seats: int, now: datetime) -> Booking:
+        offer = self._offer(offer_id)
+        if offer.driver_id == rider_id:
+            raise PermissionDenied("Drivers cannot book their own offer")
+        if offer.status is not OfferStatus.OPEN:
+            raise ConflictError("Offer is not open")
+        if seats < 1:
+            raise ValidationError("Seats must be at least 1")
+        with self._lock:
+            if any(b.offer_id == offer_id and b.rider_id == rider_id and b.status in ACTIVE
+                   for b in self.bookings.values()):
+                raise ConflictError("You already have a request for this offer")
+            self._seq += 1
+            b = Booking(id=f"b{self._seq}", offer_id=offer_id, driver_id=offer.driver_id, rider_id=rider_id,
+                        seats=seats, created_at=now, departure=offer.departure)
+            self.bookings[b.id] = b
+            return b
+
+    # CRS-F-031 / CRS-F-032 / CRS-F-024
+    def accept(self, booking_id: str, driver_id: str, now: datetime) -> Booking:
+        b = self._booking(booking_id)
+        if b.driver_id != driver_id:
+            raise PermissionDenied("Only the offer owner can decide")
+        with self._lock:  # atomic check-and-decrement
+            if b.status is not BookingStatus.PENDING:
+                raise ConflictError("Request already decided")
+            if now - b.created_at > REQUEST_TIMEOUT or now >= b.departure:
+                b.status = BookingStatus.EXPIRED
+                raise ConflictError("Request expired")
+            offer = self._offer(b.offer_id)
+            if offer.seats_available < b.seats:
+                raise ConflictError("Seats unavailable")
+            offer.seats_available -= b.seats
+            if offer.seats_available == 0:
+                offer.status = OfferStatus.FULL
+            b.status = BookingStatus.CONFIRMED
+            return b
+
+    def reject(self, booking_id: str, driver_id: str) -> Booking:
+        b = self._booking(booking_id)
+        if b.driver_id != driver_id:
+            raise PermissionDenied("Only the offer owner can decide")
+        with self._lock:
+            if b.status is not BookingStatus.PENDING:
+                raise ConflictError("Request already decided")
+            b.status = BookingStatus.REJECTED
+            return b
+
+    # CRS-F-033
+    def cancel(self, booking_id: str, user_id: str, reason: str, now: datetime) -> Booking:
+        b = self._booking(booking_id)
+        if user_id not in (b.rider_id, b.driver_id):
+            raise PermissionDenied("Not your booking")
+        if not (reason or "").strip():
+            raise ValidationError("A reason is required")
+        with self._lock:
+            if b.status not in ACTIVE:
+                raise ConflictError("Booking cannot be cancelled")
+            if b.status is BookingStatus.CONFIRMED:
+                offer = self._offer(b.offer_id)
+                offer.seats_available += b.seats
+                if offer.status is OfferStatus.FULL:
+                    offer.status = OfferStatus.OPEN
+                if b.departure - now < LATE_CANCEL_WINDOW:
+                    self.late_cancellations.setdefault(user_id, []).append(now)
+            b.status = BookingStatus.CANCELLED
+            b.ended_at = now
+            return b
+
+    def is_flagged(self, user_id: str, now: datetime) -> bool:
+        recent = [t for t in self.late_cancellations.get(user_id, []) if now - t <= LATE_CANCEL_PERIOD]
+        return len(recent) >= LATE_CANCEL_LIMIT
+
+    # CRS-F-035
+    def expire_pending(self, now: datetime, timeout: timedelta = REQUEST_TIMEOUT) -> list:
+        expired = []
+        with self._lock:
+            for b in self.bookings.values():
+                if b.status is BookingStatus.PENDING and (now - b.created_at >= timeout or now >= b.departure):
+                    b.status = BookingStatus.EXPIRED
+                    expired.append(b)
+        return expired
+
+    # CRS-F-034
+    def start_ride(self, offer_id: str, driver_id: str) -> RideOffer:
+        offer = self._offer(offer_id)
+        if offer.driver_id != driver_id:
+            raise PermissionDenied("Only the driver can start the ride")
+        if offer.status not in (OfferStatus.OPEN, OfferStatus.FULL):
+            raise ConflictError("Ride cannot be started")
+        if not any(b.offer_id == offer_id and b.status is BookingStatus.CONFIRMED for b in self.bookings.values()):
+            raise ConflictError("No confirmed riders")
+        offer.status = OfferStatus.STARTED
+        for b in self.bookings.values():
+            if b.offer_id == offer_id and b.status is BookingStatus.CONFIRMED:
+                b.status = BookingStatus.STARTED
+        return offer
+
+    def complete_ride(self, offer_id: str, driver_id: str, now: datetime) -> RideOffer:
+        offer = self._offer(offer_id)
+        if offer.driver_id != driver_id:
+            raise PermissionDenied("Only the driver can complete the ride")
+        if offer.status is not OfferStatus.STARTED:
+            raise ConflictError("Ride is not in progress")
+        offer.status = OfferStatus.COMPLETED
+        for b in self.bookings.values():
+            if b.offer_id == offer_id and b.status is BookingStatus.STARTED:
+                b.status = BookingStatus.COMPLETED
+                b.ended_at = now
+        return offer
diff --git a/tests/test_booking.py b/tests/test_booking.py
new file mode 100644
index 0000000..6a6bb60
--- /dev/null
+++ b/tests/test_booking.py
@@ -0,0 +1,143 @@
+import threading
+from datetime import datetime, timedelta
+
+import pytest
+
+from campusride.booking import BookingService
+from campusride.errors import ConflictError, NotFound, PermissionDenied, ValidationError
+from campusride.models import BookingStatus, GeoPoint, OfferStatus, RideOffer
+
+NOW = datetime(2026, 10, 13, 8, 0)
+P = GeoPoint(13.0, 80.2)
+
+
+def make(seats=3, departure=NOW + timedelta(hours=3)):
+    svc = BookingService()
+    svc.add_offer(RideOffer(id="o1", driver_id="d1", origin=P, destination=P, route=[P, P], departure=departure,
+                            seats_total=seats, seats_available=seats))
+    return svc
+
+
+def test_join_request_and_duplicate_rejected():  # TC-Book-01
+    svc = make()
+    b = svc.send_join_request("o1", "r1", 1, NOW)
+    assert b.status is BookingStatus.PENDING
+    with pytest.raises(ConflictError):
+        svc.send_join_request("o1", "r1", 1, NOW)
+    with pytest.raises(PermissionDenied):
+        svc.send_join_request("o1", "d1", 1, NOW)
+    with pytest.raises(NotFound):
+        svc.send_join_request("nope", "r1", 1, NOW)
+
+
+def test_accept_reject_and_owner_check():  # TC-Book-02
+    svc = make()
+    b1 = svc.send_join_request("o1", "r1", 1, NOW)
+    b2 = svc.send_join_request("o1", "r2", 1, NOW)
+    with pytest.raises(PermissionDenied):
+        svc.accept(b1.id, "intruder", NOW)
+    assert svc.accept(b1.id, "d1", NOW).status is BookingStatus.CONFIRMED
+    assert svc.reject(b2.id, "d1").status is BookingStatus.REJECTED
+    with pytest.raises(ConflictError):
+        svc.accept(b1.id, "d1", NOW)  # already decided
+
+
+def test_acceptance_reduces_seats_and_marks_full():  # TC-Book-03
+    svc = make(seats=2)
+    b = svc.send_join_request("o1", "r1", 2, NOW)
+    svc.accept(b.id, "d1", NOW)
+    offer = svc.offers["o1"]
+    assert offer.seats_available == 0 and offer.status is OfferStatus.FULL
+    with pytest.raises(ConflictError):
+        svc.send_join_request("o1", "r2", 1, NOW)  # full offers are closed
+
+
+def test_cannot_accept_more_seats_than_available():
+    svc = make(seats=2)
+    b1 = svc.send_join_request("o1", "r1", 2, NOW)
+    b2 = svc.send_join_request("o1", "r2", 1, NOW)
+    svc.accept(b1.id, "d1", NOW)
+    with pytest.raises(ConflictError, match="Seats unavailable"):
+        svc.accept(b2.id, "d1", NOW)
+
+
+def test_cancel_confirmed_restores_seats():  # TC-Book-04
+    svc = make(seats=2)
+    b = svc.send_join_request("o1", "r1", 2, NOW)
+    svc.accept(b.id, "d1", NOW)
+    svc.cancel(b.id, "r1", "plans changed", NOW)
+    assert svc.offers["o1"].seats_available == 2 and svc.offers["o1"].status is OfferStatus.OPEN
+    with pytest.raises(ValidationError):
+        svc.cancel(svc.send_join_request("o1", "r1", 1, NOW).id, "r1", " ", NOW)
+    with pytest.raises(PermissionDenied):
+        svc.cancel(b.id, "stranger", "x", NOW)
+
+
+def test_repeated_late_cancellations_are_flagged():  # TC-Book-05
+    svc = BookingService()
+    for i in range(3):
+        dep = NOW + timedelta(days=i, minutes=30)
+        svc.add_offer(RideOffer(id=f"o{i}", driver_id="d1", origin=P, destination=P, route=[P, P], departure=dep,
+                                seats_total=1, seats_available=1))
+        b = svc.send_join_request(f"o{i}", "r1", 1, dep - timedelta(hours=5))
+        svc.accept(b.id, "d1", dep - timedelta(hours=5))
+        assert not svc.is_flagged("r1", dep) if i < 2 else True
+        svc.cancel(b.id, "r1", "late", dep - timedelta(minutes=30))  # < 1 h before departure
+    assert svc.is_flagged("r1", NOW + timedelta(days=3))
+    assert not svc.is_flagged("r1", NOW + timedelta(days=60))
+
+
+def test_ride_lifecycle_transitions():  # TC-Book-06
+    svc = make()
+    b = svc.send_join_request("o1", "r1", 1, NOW)
+    with pytest.raises(ConflictError):
+        svc.start_ride("o1", "d1")  # no confirmed riders yet
+    svc.accept(b.id, "d1", NOW)
+    with pytest.raises(PermissionDenied):
+        svc.start_ride("o1", "other")
+    with pytest.raises(ConflictError):
+        svc.complete_ride("o1", "d1", NOW)  # not started
+    svc.start_ride("o1", "d1")
+    assert b.status is BookingStatus.STARTED
+    svc.complete_ride("o1", "d1", NOW + timedelta(hours=1))
+    assert b.status is BookingStatus.COMPLETED and b.ended_at is not None
+    with pytest.raises(ConflictError):
+        svc.start_ride("o1", "d1")
+
+
+def test_pending_requests_expire():  # TC-Book-07
+    svc = make()
+    b = svc.send_join_request("o1", "r1", 1, NOW)
+    assert svc.expire_pending(NOW + timedelta(minutes=29)) == []
+    assert svc.expire_pending(NOW + timedelta(minutes=30)) == [b]
+    assert b.status is BookingStatus.EXPIRED
+    b2 = svc.send_join_request("o1", "r2", 1, NOW)
+    svc.expire_pending(NOW + timedelta(hours=3))  # departure reached
+    assert b2.status is BookingStatus.EXPIRED
+
+
+def test_accepting_expired_request_fails():
+    svc = make()
+    b = svc.send_join_request("o1", "r1", 1, NOW)
+    with pytest.raises(ConflictError, match="expired"):
+        svc.accept(b.id, "d1", NOW + timedelta(minutes=31))
+
+
+def test_concurrent_acceptance_never_overbooks():  # TC-Match-06
+    svc = make(seats=3)
+    ids = [svc.send_join_request("o1", f"r{i}", 1, NOW).id for i in range(100)]
+    results = []
+
+    def worker(bid):
+        try:
+            svc.accept(bid, "d1", NOW)
+            results.append("ok")
+        except ConflictError:
+            results.append("conflict")
+
+    threads = [threading.Thread(target=worker, args=(i,)) for i in ids]
+    [t.start() for t in threads]
+    [t.join() for t in threads]
+    assert results.count("ok") == 3 and results.count("conflict") == 97
+    assert svc.offers["o1"].seats_available == 0
+    assert sum(b.status is BookingStatus.CONFIRMED for b in svc.bookings.values()) == 3

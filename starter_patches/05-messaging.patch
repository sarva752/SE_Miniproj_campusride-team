@@ -0,0 +1,112 @@
+"""In-app chat between a rider and a driver who share a booking.
+
+Covers CRS-F-040..044 and the chat rate limit of CRS-SR-006 (30 messages/minute/user).
+"""
+from __future__ import annotations
+
+import html
+from collections import defaultdict, deque
+from dataclasses import dataclass
+from datetime import datetime, timedelta
+from typing import Optional
+
+from .errors import PermissionDenied, ValidationError
+from .models import Booking, BookingStatus
+
+MAX_LENGTH = 1000
+READ_ONLY_AFTER = timedelta(hours=24)
+RATE_LIMIT = 30
+RATE_WINDOW = timedelta(minutes=1)
+
+
+class RateLimited(Exception):
+    """Too many messages (maps to HTTP 429)."""
+
+
+@dataclass
+class Message:
+    id: int
+    booking_id: str
+    sender_id: str
+    content: str
+    sent_at: datetime
+    read_at: Optional[datetime] = None
+
+
+class ChatService:
+    def __init__(self):
+        self._messages: dict[str, list[Message]] = defaultdict(list)
+        self._blocks: set[tuple[str, str]] = set()  # (blocker, blocked)
+        self._recent: dict[str, deque] = defaultdict(deque)
+        self.reports: list[tuple[str, str, str]] = []  # (reporter, target, reason)
+        self._seq = 0
+
+    # CRS-F-042
+    def block(self, blocker: str, blocked: str) -> None:
+        self._blocks.add((blocker, blocked))
+
+    def is_blocked(self, a: str, b: str) -> bool:
+        return (a, b) in self._blocks or (b, a) in self._blocks
+
+    def blocked_pairs(self) -> set:
+        """Pairs usable by the matching engine's ``blocked`` argument."""
+        return set(self._blocks)
+
+    def report(self, reporter: str, target: str, reason: str) -> None:
+        if not (reason or "").strip():
+            raise ValidationError("A reason is required")
+        self.reports.append((reporter, target, reason.strip()))
+
+    @staticmethod
+    def _partner(booking: Booking, user_id: str) -> str:
+        if user_id == booking.rider_id:
+            return booking.driver_id
+        if user_id == booking.driver_id:
+            return booking.rider_id
+        raise PermissionDenied("You are not part of this booking")  # CRS-F-040
+
+    def _open_for_chat(self, booking: Booking, now: datetime) -> bool:
+        if booking.status in (BookingStatus.PENDING, BookingStatus.CONFIRMED, BookingStatus.STARTED):
+            return True
+        if booking.status in (BookingStatus.COMPLETED, BookingStatus.CANCELLED) and booking.ended_at:
+            return now - booking.ended_at <= READ_ONLY_AFTER  # CRS-F-043
+        return False
+
+    def _check_rate(self, user_id: str, now: datetime) -> None:
+        q = self._recent[user_id]
+        while q and now - q[0] >= RATE_WINDOW:
+            q.popleft()
+        if len(q) >= RATE_LIMIT:
+            raise RateLimited("Too many messages")
+        q.append(now)
+
+    # CRS-F-040, 041, 042, 044
+    def send(self, booking: Booking, sender_id: str, content: str, now: datetime) -> Message:
+        partner = self._partner(booking, sender_id)
+        if self.is_blocked(sender_id, partner):
+            raise PermissionDenied("Messaging is blocked between these users")
+        if not self._open_for_chat(booking, now):
+            raise PermissionDenied("This chat is read-only")
+        text = (content or "").strip()
+        if not text:
+            raise ValidationError("Message cannot be empty")
+        if len(text) > MAX_LENGTH:
+            raise ValidationError(f"Message exceeds {MAX_LENGTH} characters")
+        self._check_rate(sender_id, now)
+        self._seq += 1
+        msg = Message(self._seq, booking.id, sender_id, html.escape(text), now)  # sanitised before storage
+        self._messages[booking.id].append(msg)
+        return msg
+
+    def history(self, booking: Booking, user_id: str) -> list:
+        self._partner(booking, user_id)
+        return list(self._messages[booking.id])
+
+    def mark_read(self, booking: Booking, reader_id: str, now: datetime) -> int:
+        self._partner(booking, reader_id)
+        n = 0
+        for m in self._messages[booking.id]:
+            if m.sender_id != reader_id and m.read_at is None:
+                m.read_at = now
+                n += 1
+        return n
diff --git a/tests/test_messaging.py b/tests/test_messaging.py
new file mode 100644
index 0000000..08e0189
--- /dev/null
+++ b/tests/test_messaging.py
@@ -0,0 +1,82 @@
+from datetime import datetime, timedelta
+
+import pytest
+
+from campusride.errors import PermissionDenied, ValidationError
+from campusride.messaging import ChatService, RateLimited
+from campusride.models import Booking, BookingStatus
+
+NOW = datetime(2026, 10, 13, 8, 0)
+
+
+def booking(status=BookingStatus.CONFIRMED, ended_at=None):
+    return Booking(id="b1", offer_id="o1", driver_id="d1", rider_id="r1", seats=1, status=status,
+                   created_at=NOW, departure=NOW + timedelta(hours=1), ended_at=ended_at)
+
+
+def test_only_booking_participants_can_chat():  # TC-Msg-01
+    chat, b = ChatService(), booking()
+    chat.send(b, "r1", "Hi", NOW)
+    chat.send(b, "d1", "Hello", NOW)
+    with pytest.raises(PermissionDenied):
+        chat.send(b, "stranger", "hey", NOW)
+    with pytest.raises(PermissionDenied):
+        chat.history(b, "stranger")
+
+
+def test_pending_booking_allows_chat_but_rejected_does_not():
+    chat = ChatService()
+    chat.send(booking(BookingStatus.PENDING), "r1", "Is the pickup at gate 2?", NOW)
+    with pytest.raises(PermissionDenied):
+        chat.send(booking(BookingStatus.REJECTED), "r1", "hi", NOW)
+
+
+def test_messages_persist_with_read_status():  # TC-Msg-02
+    chat, b = ChatService(), booking()
+    chat.send(b, "r1", "On my way", NOW)
+    assert len(chat.history(b, "d1")) == 1
+    assert chat.mark_read(b, "d1", NOW + timedelta(seconds=2)) == 1
+    assert chat.history(b, "r1")[0].read_at == NOW + timedelta(seconds=2)
+    assert chat.mark_read(b, "d1", NOW) == 0  # already read
+
+
+def test_block_and_report():  # TC-Msg-03
+    chat, b = ChatService(), booking()
+    chat.block("d1", "r1")
+    for sender in ("r1", "d1"):  # blocked in both directions
+        with pytest.raises(PermissionDenied):
+            chat.send(b, sender, "hello", NOW)
+    assert ("d1", "r1") in chat.blocked_pairs()
+    chat.report("d1", "r1", "abusive language")
+    assert chat.reports == [("d1", "r1", "abusive language")]
+    with pytest.raises(ValidationError):
+        chat.report("d1", "r1", "  ")
+
+
+def test_chat_becomes_read_only_24h_after_ride_end():  # TC-Msg-04
+    ended = NOW
+    chat, b = ChatService(), booking(BookingStatus.COMPLETED, ended)
+    chat.send(b, "r1", "thanks!", ended + timedelta(hours=23))
+    with pytest.raises(PermissionDenied):
+        chat.send(b, "r1", "one more", ended + timedelta(hours=25))
+    assert len(chat.history(b, "r1")) == 1  # history stays readable
+
+
+def test_length_limit_and_sanitisation():  # TC-Msg-05
+    chat, b = ChatService(), booking()
+    assert chat.send(b, "r1", "x" * 1000, NOW)  # boundary OK
+    with pytest.raises(ValidationError):
+        chat.send(b, "r1", "x" * 1001, NOW)
+    with pytest.raises(ValidationError):
+        chat.send(b, "r1", "   ", NOW)
+    m = chat.send(b, "r1", "<script>alert(1)</script>", NOW)
+    assert "<script>" not in m.content and "&lt;script&gt;" in m.content
+
+
+def test_rate_limit_30_per_minute():  # TC-Sec-07
+    chat, b = ChatService(), booking()
+    for i in range(30):
+        chat.send(b, "r1", f"m{i}", NOW)
+    with pytest.raises(RateLimited):
+        chat.send(b, "r1", "31st", NOW + timedelta(seconds=30))
+    assert chat.send(b, "r1", "later", NOW + timedelta(seconds=61))

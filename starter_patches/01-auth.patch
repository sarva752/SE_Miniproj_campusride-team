diff --git a/src/campusride/auth.py b/src/campusride/auth.py
new file mode 100644
index 0000000..28896bb
--- /dev/null
+++ b/src/campusride/auth.py
@@ -0,0 +1,131 @@
+"""Registration, OTP verification, login and lockout (CRS-F-001..003, CRS-SR-002).
+
+Time is passed in explicitly (``now``) so behaviour is deterministic in tests.
+"""
+from __future__ import annotations
+
+import hashlib
+import hmac
+import os
+import re
+import secrets
+from datetime import datetime, timedelta
+from typing import Optional
+
+from .errors import AuthenticationError, ConflictError, ValidationError
+from .models import Role, User, UserStatus
+
+OTP_TTL = timedelta(minutes=10)
+LOCK_AFTER_FAILURES = 5
+LOCK_DURATION = timedelta(minutes=15)
+DEFAULT_DOMAINS = frozenset({"example.edu"})
+
+_EMAIL_RE = re.compile(r"^[A-Za-z0-9._%+-]+@([A-Za-z0-9.-]+\.[A-Za-z]{2,})$")
+
+
+def is_institutional_email(email: str, allowed_domains=DEFAULT_DOMAINS) -> bool:
+    m = _EMAIL_RE.match(email or "")
+    return bool(m) and m.group(1).lower() in {d.lower() for d in allowed_domains}
+
+
+def validate_password(password: str) -> None:
+    """Minimum 8 characters with letters and digits (CRS-SR-002)."""
+    if len(password or "") < 8:
+        raise ValidationError("Password must be at least 8 characters")
+    if not re.search(r"[A-Za-z]", password) or not re.search(r"\d", password):
+        raise ValidationError("Password must contain letters and digits")
+
+
+def hash_password(password: str, salt: Optional[bytes] = None) -> str:
+    """Salted scrypt hash, stored as ``salt$hash`` (hex). Never store plain text."""
+    salt = salt or os.urandom(16)
+    digest = hashlib.scrypt(password.encode(), salt=salt, n=2 ** 14, r=8, p=1)
+    return salt.hex() + "$" + digest.hex()
+
+
+def verify_password(password: str, stored: str) -> bool:
+    salt_hex, hash_hex = stored.split("$")
+    digest = hashlib.scrypt(password.encode(), salt=bytes.fromhex(salt_hex), n=2 ** 14, r=8, p=1)
+    return hmac.compare_digest(digest.hex(), hash_hex)
+
+
+class OtpService:
+    """Six-digit single-use OTP valid for 10 minutes."""
+
+    def __init__(self):
+        self._codes: dict[str, tuple[str, datetime]] = {}
+
+    def issue(self, email: str, now: datetime) -> str:
+        code = f"{secrets.randbelow(10 ** 6):06d}"
+        self._codes[email.lower()] = (code, now + OTP_TTL)
+        return code
+
+    def verify(self, email: str, code: str, now: datetime) -> bool:
+        entry = self._codes.get(email.lower())
+        if not entry:
+            return False
+        stored, expires = entry
+        if now > expires or not hmac.compare_digest(stored, str(code)):
+            return False
+        del self._codes[email.lower()]  # single use
+        return True
+
+
+class AuthService:
+    def __init__(self, allowed_domains=DEFAULT_DOMAINS):
+        self.allowed_domains = allowed_domains
+        self.otp = OtpService()
+        self._users: dict[str, User] = {}
+        self._hashes: dict[str, str] = {}
+        self._failures: dict[str, int] = {}
+        self._locked_until: dict[str, datetime] = {}
+        self.audit: list[tuple[datetime, str, str]] = []  # (time, event, email)
+
+    # CRS-F-001
+    def register(self, email: str, name: str, password: str, now: datetime):
+        email = (email or "").strip().lower()
+        if not is_institutional_email(email, self.allowed_domains):
+            raise ValidationError("Use your institutional email address")
+        if not (name or "").strip():
+            raise ValidationError("Name is required")
+        validate_password(password)
+        if email in self._users:
+            raise ConflictError("Email already registered")
+        user = User(id=f"u{len(self._users) + 1}", email=email, name=name.strip(),
+                    role=Role.RIDER, status=UserStatus.INACTIVE)
+        self._users[email] = user
+        self._hashes[email] = hash_password(password)
+        return user, self.otp.issue(email, now)
+
+    def verify_email(self, email: str, code: str, now: datetime) -> User:
+        email = email.strip().lower()
+        if email not in self._users or not self.otp.verify(email, code, now):
+            raise ValidationError("Invalid or expired OTP")
+        self._users[email].status = UserStatus.ACTIVE
+        return self._users[email]
+
+    # CRS-F-002 / CRS-F-003
+    def login(self, email: str, password: str, now: datetime) -> User:
+        email = (email or "").strip().lower()
+        locked = self._locked_until.get(email)
+        if locked and now < locked:
+            raise AuthenticationError("Account locked, try again later")
+        user = self._users.get(email)
+        ok = bool(user) and verify_password(password, self._hashes[email])
+        if not ok:
+            self._record_failure(email, now)
+            raise AuthenticationError("Invalid credentials")  # generic message
+        if user.status is UserStatus.INACTIVE:
+            raise AuthenticationError("Account not verified")
+        if user.status is UserStatus.SUSPENDED:
+            raise AuthenticationError("Account suspended")
+        self._failures.pop(email, None)
+        self._locked_until.pop(email, None)
+        return user
+
+    def _record_failure(self, email: str, now: datetime) -> None:
+        self._failures[email] = self._failures.get(email, 0) + 1
+        if self._failures[email] >= LOCK_AFTER_FAILURES:
+            self._locked_until[email] = now + LOCK_DURATION
+            self._failures[email] = 0
+            self.audit.append((now, "ACCOUNT_LOCKED", email))
diff --git a/tests/test_auth.py b/tests/test_auth.py
new file mode 100644
index 0000000..a3f568f
--- /dev/null
+++ b/tests/test_auth.py
@@ -0,0 +1,89 @@
+from datetime import datetime, timedelta
+
+import pytest
+
+from campusride.auth import (AuthService, OtpService, hash_password,
+                             is_institutional_email, validate_password,
+                             verify_password)
+from campusride.errors import AuthenticationError, ConflictError, ValidationError
+from campusride.models import UserStatus
+
+NOW = datetime(2026, 10, 12, 9, 0)
+PW = "Ride#2026a"
+
+
+def make_verified(svc=None):
+    svc = svc or AuthService()
+    _, code = svc.register("asha@example.edu", "Asha K", PW, NOW)
+    svc.verify_email("asha@example.edu", code, NOW)
+    return svc
+
+
+def test_institutional_email_rules():  # TC-Auth-02
+    assert is_institutional_email("a@example.edu")
+    assert is_institutional_email("A@EXAMPLE.EDU")
+    assert not is_institutional_email("a@gmail.com")
+    assert not is_institutional_email("not-an-email")
+
+
+@pytest.mark.parametrize("pw", ["short1", "allletters", "12345678"])
+def test_password_policy_rejects_weak(pw):  # CRS-SR-002
+    with pytest.raises(ValidationError):
+        validate_password(pw)
+
+
+def test_password_hash_is_salted_and_verifiable():  # TC-Sec-03
+    h1, h2 = hash_password(PW), hash_password(PW)
+    assert h1 != h2 and PW not in h1
+    assert verify_password(PW, h1) and not verify_password("wrong", h1)
+
+
+def test_register_and_verify_flow():  # TC-Auth-01
+    svc = AuthService()
+    user, code = svc.register("asha@example.edu", "Asha K", PW, NOW)
+    assert user.status is UserStatus.INACTIVE
+    with pytest.raises(AuthenticationError):
+        svc.login("asha@example.edu", PW, NOW)  # not yet verified
+    svc.verify_email("asha@example.edu", code, NOW + timedelta(minutes=5))
+    assert svc.login("asha@example.edu", PW, NOW).status is UserStatus.ACTIVE
+
+
+def test_register_rejects_foreign_domain_and_duplicates():  # TC-Auth-02
+    svc = AuthService()
+    with pytest.raises(ValidationError):
+        svc.register("x@gmail.com", "X", PW, NOW)
+    svc.register("a@example.edu", "A", PW, NOW)
+    with pytest.raises(ConflictError):
+        svc.register("a@example.edu", "A", PW, NOW)
+
+
+def test_otp_expiry_wrong_code_and_single_use():  # TC-Auth-02
+    otp = OtpService()
+    code = otp.issue("a@example.edu", NOW)
+    assert not otp.verify("a@example.edu", "000000" if code != "000000" else "111111", NOW)
+    assert not otp.verify("a@example.edu", code, NOW + timedelta(minutes=11))
+    code = otp.issue("a@example.edu", NOW)
+    assert otp.verify("a@example.edu", code, NOW + timedelta(minutes=9))
+    assert not otp.verify("a@example.edu", code, NOW)  # already used
+
+
+def test_login_valid_and_invalid_generic_error():  # TC-Auth-03
+    svc = make_verified()
+    assert svc.login("asha@example.edu", PW, NOW).name == "Asha K"
+    with pytest.raises(AuthenticationError) as e1:
+        svc.login("asha@example.edu", "wrongpass1", NOW)
+    with pytest.raises(AuthenticationError) as e2:
+        svc.login("nobody@example.edu", "wrongpass1", NOW)
+    assert str(e1.value) == str(e2.value)  # no user enumeration
+
+
+def test_lockout_after_five_failures_and_audit():  # TC-Auth-05
+    svc = make_verified()
+    for _ in range(5):
+        with pytest.raises(AuthenticationError):
+            svc.login("asha@example.edu", "bad-pass-1", NOW)
+    with pytest.raises(AuthenticationError, match="locked"):
+        svc.login("asha@example.edu", PW, NOW + timedelta(minutes=5))
+    assert svc.audit and svc.audit[0][1] == "ACCOUNT_LOCKED"
+    # unlocked after 15 minutes
+    assert svc.login("asha@example.edu", PW, NOW + timedelta(minutes=16))
